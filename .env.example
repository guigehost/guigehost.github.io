# ── Runtime ─────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── Database ───────────────────────────────────────────────────
# MySQL connection string (mysql://user:pass@host:port/db)
DATABASE_URL=mysql://user:pass@127.0.0.1:3306/guige_host

# ── Session ────────────────────────────────────────────────────
# 用于签发 cookie 的会话 JWT。生产环境请用 `openssl rand -base64 48` 生成 ≥ 32 字符的强随机串
SESSION_SECRET=replace-with-strong-random-32-chars-or-more
